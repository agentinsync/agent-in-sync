{
  "name": "@agent-in-sync/mcp-server",
  "version": "0.0.1",
  "description": "agent-in-sync MCP Server with HTTP Transport",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist",
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agent-in-sync/backend": "workspace:*",
    "@agent-in-sync/db-client": "workspace:*",
    "@agent-in-sync/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.2",
    "express": "^4.22.2",
    "express-rate-limit": "^8.5.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.19",
    "tsx": "^4.22.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
