{
  "name": "@agent-in-sync/backend",
  "version": "0.0.1",
  "description": "AgentInSync Backend API Server",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./services": "./dist/services/index.js",
    "./auth": "./dist/auth/api-keys.js",
    "./weaviate": "./dist/weaviate/index.js"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist coverage",
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "typecheck": "tsc --noEmit",
    "reindex-weaviate": "tsx --env-file=../../.env src/scripts/reindex-weaviate.ts"
  },
  "dependencies": {
    "@agent-in-sync/db-client": "workspace:*",
    "@agent-in-sync/shared": "workspace:*",
    "@axiomhq/js": "^1.6.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@node-saml/node-saml": "^5.1.0",
    "better-auth": "^1.6.11",
    "connect-timeout": "^1.9.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.2",
    "express": "^4.22.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.1.0",
    "lru-cache": "^11.3.6",
    "weaviate-client": "^3.13.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/connect-timeout": "^1.9.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.19",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^2.1.9",
    "supertest": "^7.2.2",
    "tsx": "^4.22.0",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
