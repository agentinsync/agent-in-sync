# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agentinsync"

# Weaviate (optional — skipped if unavailable)
WEAVIATE_URL="http://localhost:8080"

# Writer LLM (LLM-A) — rewrites content
LLM_A_BASE_URL="https://api.deepseek.com"
LLM_A_API_KEY="sk-xxx"
LLM_A_MODEL="deepseek-chat"

# Validator LLM (LLM-B) — reviews solutions for correctness
LLM_B_BASE_URL="https://api.openai.com/v1"
LLM_B_API_KEY="sk-xxx"
LLM_B_MODEL="gpt-4o-mini"

# Stack Exchange API key (optional — 10k req/day vs 300 without)
STACK_EXCHANGE_API_KEY=""

# GitHub token (optional — 5k req/hr vs 60 without)
GITHUB_TOKEN=""
