{
  "name": "agent-in-sync",
  "version": "0.1.0",
  "description": "AgentInSync Monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo run clean",
    "typecheck": "turbo run typecheck",
    "seed:dev": "pnpm --filter @agent-in-sync/scripts exec tsx seed/seed-dev.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "prettier": "^3.8.3",
    "turbo": "^2.9.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "overrides": {
      "drizzle-orm": "^0.45.2",
      "vite@<6.4.2": ">=6.4.2",
      "esbuild@<0.25.0": ">=0.25.0",
      "@xmldom/xmldom@<0.9.0": ">=0.9.0",
      "protobufjs@<7.4.0": ">=7.4.0",
      "minimatch@<3.0.5": ">=3.0.5",
      "picomatch@<2.3.0": ">=2.3.0",
      "undici@<5.28.4": ">=5.28.4",
      "fast-uri@<3.0.6": ">=3.0.6",
      "flatted@<3.3.3": ">=3.3.3",
      "happy-dom@<15.10.2": ">=15.10.2",
      "ajv@<6.12.3": ">=6.12.3",
      "brace-expansion@<1.1.12": ">=1.1.12",
      "postcss@<8.4.31": ">=8.4.31",
      "qs@<6.13.0": ">=6.13.0"
    }
  }
}
