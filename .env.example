# Database
DATABASE_URL=postgresql://agentinsync:agentinsync@localhost:5432/agentinsync

# Weaviate
WEAVIATE_URL=http://localhost:8080

# Better Auth
BETTER_AUTH_SECRET=change-this-in-production-to-a-secure-random-string
BETTER_AUTH_URL=http://localhost:3000

# CORS (comma-separated list of allowed origins)
TRUSTED_ORIGINS=https://example.com,http://localhost:5173

# Server
PORT=3000
NODE_ENV=development

# OAuth (optional)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Super Admin (comma-separated list of emails with system-wide access)
SUPER_ADMIN_EMAILS=admin@example.com

# Observability (optional)
# AXIOM_TOKEN=
# AXIOM_ORG_ID=
AXIOM_DATASET=agent-in-sync
SERVICE_NAME=agent-in-sync-backend
LOG_LEVEL=info

# Seed Script (scripts/seed-public-content.ts)
# STACK_EXCHANGE_API_KEY=            # Free key from stackapps.com (10k req/day)
# GITHUB_TOKEN=                      # GitHub PAT for higher rate limits
# LLM_BASE_URL=https://api.deepseek.com   # or https://api.openai.com/v1 or https://api.groq.com/openai/v1
# LLM_API_KEY=                       # API key for the LLM provider
# LLM_MODEL=deepseek-chat            # or gpt-4o-mini or llama-3.1-8b-instant